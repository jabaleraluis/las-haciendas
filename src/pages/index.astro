---
import Layout from "../layouts/Layout.astro";
import { products } from "src/scripts/products";
import Products from "@components/structure/Products.astro";

const popularProducts = products.filter((p) => p.tags?.includes("popular"));
---

<Layout>
  <section class="hero__section" id="home">
    <div class="hero__content">
      <div class="title__wrapper">
        <h1>Las Haciendas</h1>
        <h2>Cocina Económica</h2>
        <p>Sabor casero todos los días, platillos económicos preparados con amor para que comas rico sin gastar de más.</p>
      </div>
      <div class="btn__wrapper">
        <a href="#menu" class="menu-btn">Ver menú</a>
        <div class="social__links">
          <a href="#" aria-label="WhatsApp" target="_blank" rel="noopener noreferrer"><i class="ri-whatsapp-line"></i></a>
          <a href="#" aria-label="Facebook" target="_blank" rel="noopener noreferrer"><i class="ri-facebook-circle-fill"></i></a>
          <a href="#" aria-label="Instagram" target="_blank" rel="noopener noreferrer"><i class="ri-instagram-line"></i></a>
        </div>
      </div>
    </div>

    <div class="hero__img">
      <img src="/src/assets/images/index/hero/hero.png" alt="Platillos caseros de Cocina Las Haciendas" />
      <svg viewBox="-80 -80 170 160" xmlns="http://www.w3.org/2000/svg">
        <path d="M42.3,-73.1C52,-67.7,54.9,-50.6,62.2,-36.4C69.6,-22.3,81.2,-11.1,85.3,2.3C89.3,15.8,85.7,31.6,76.2,42C66.8,52.4,51.4,57.4,37.7,63C24,68.5,12,74.6,1.3,72.4C-9.5,70.2,-19,59.8,-31,53.3C-43.1,46.8,-57.7,44.3,-66.7,36.1C-75.6,27.9,-78.8,13.9,-77.9,0.5C-77,-12.9,-72.1,-25.8,-65.9,-38.8C-59.8,-51.8,-52.4,-64.9,-41.2,-69.5C-30,-74,-15,-70,0.7,-71.1C16.3,-72.2,32.7,-78.5,42.3,-73.1Z"></path>
      </svg>
    </div>
  </section>

  <section class="services__section" id="services">
    <div class="section-title">
      <h2>Nuestros Servicios</h2>
      <h1>¿Qué Ofrecemos?</h1>
    </div>
    <div class="services__wrapper">
      <div class="service">
        <img src="src/assets/images/index/services/dinner.png" alt="" />
        <h1>Comida Casera</h1>
        <p>Comida recién hecha con el sazón del hogar.</p>
      </div>
      <div class="service">
        <img src="src/assets/images/index/services/clock.png" alt="" />
        <h1>Servicio Rápido</h1>
        <p>Rápido y práctico, para que no pierdas tiempo.</p>
      </div>
      <div class="service">
        <img src="src/assets/images/index/services/piggy-bank.png" alt="" />
        <h1>Precios justos</h1>
        <p>Comer bien y delicioso, no tiene que ser caro.</p>
      </div>
    </div>
  </section>

  <!-- <hr style="width: 25%; margin: 0 auto"> -->

  <section class="products__section" id="menu">
    <div class="section-title">
      <h2>Nuestro Menú</h2>
      <h1>¡Oferta Del Día!</h1>
    </div>
    <div class="plate__hero product-content">
      <div class="promotion-badge"><i class="ri-sparkling-fill"></i> promoción <i class="ri-sparkling-fill"></i></div>
      <h1>Platillo Especial</h1>
      <div class="price">
        <span>$</span>
        <p>100</p>
      </div>
      <h2>1 Guiso + 2 Guarniciones</h2>
      <p class="description">¡Elige tu guiso favorito y acompáñalo con dos guarniciones a tu elección!</p>
    </div>
    <div class="see-all-btn">
      <a class="menu-btn" href="/menu">Ver Menú Completo <i class="ri-arrow-right-s-line"></i></a>
    </div>
  </section>

  <section class="location" id="location">
    <div class="section-title">
      <h2>Ubicación</h2>
      <h1>Ven a Visitarnos</h1>
    </div>
    <div class="location-wrapper">
      <div class="map">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1052.235880457659!2d-109.91005924513182!3d27.49149451791862!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x86c815d1be1b7167%3A0xade9bcdf63c49d71!2sAv.%20No%20Reeleccion%202408%2C%20Las%20Haciendas%2C%2085064%20Cdad.%20Obreg%C3%B3n%2C%20Son.!5e0!3m2!1ses-419!2smx!4v1768337488060!5m2!1ses-419!2smx" allowfullscreen="true" loading="lazy" referrerpolicy="no-referrer-when-downgrade"> </iframe>
      </div>
      <div class="info-section">
        <div class="item">
          <i class="ri-map-pin-2-line"></i>
          <div class="label">
            <span>Dirección</span>
            <p>
              No. Reelección #2408<br />
              Ciudad Obregón, Sonora
            </p>
          </div>
        </div>
        <div class="item">
          <i class="ri-pushpin-line"></i>
          <div class="label">
            <span>Referencias</span>
            <p>
              Entre privada San Miguel y Bartolomé<br />
              (Frente a Ley Exprés)
            </p>
          </div>
        </div>
        <div class="item">
          <i class="ri-map-pin-time-line"></i>
          <div class="label">
            <span>Colonia</span>
            <p>
              Las Haciendas, 85064 <br />
              Zona Residencial
            </p>
          </div>
        </div>
        <div class="btn__wrapper">
          <a href="https://www.google.com/maps/dir//Av.+No+Reeleccion+2408,+Las+Haciendas,+85064+Cdad.+Obregón,+Son." target="_blank" rel="noopener noreferrer" class="get-there-btn"><i class="ri-navigation-fill"></i> Cómo llegar</a>
          <a href="wa.me/" target="_blank" rel="noopener noreferrer" class="call-btn"><i class="ri-phone-fill"></i> Llamar</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
